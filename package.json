{
  "name": "cyber-awareness-challenge",
  "version": "1.0.0",
  "description": "Real-time Cybersecurity Awareness Challenge platform with anti-cheat proctoring, deterministic scoring, and admin controls.",
  "main": "src/app.js",
  "scripts": {
    "test": "node node_modules/jest/bin/jest.js --runInBand --forceExit",
    "test:ci": "node node_modules/jest/bin/jest.js --runInBand --ci --forceExit",
    "lint": "eslint src/ tests/ --ext .js",
    "lint:fix": "eslint src/ tests/ --ext .js --fix",
    "build": "node scripts/build.js",
    "serve": "npx serve . -l 3000",
    "start": "npx serve . -l 3000"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "babel-jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": ["babel-jest", { "presets": [["@babel/preset-env", { "targets": { "node": "current" } }]] }]
    },
    "transformIgnorePatterns": []
  },
  "keywords": ["cybersecurity", "quiz", "challenge", "proctoring", "anti-cheat"],
  "author": "CyberArena Engineering",
  "license": "MIT"
}
